# Copy to .env and change the keys before exposing this service to anything.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   # generate a key

# --- Database -----------------------------------------------------------------
# SQLite (default). Path is relative to the repo root.
DATABASE_URL=sqlite+pysqlite:///./data/timeline.db
#
# Postgres later — nothing else in the app needs to change:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ukr_timeline

# --- Auth ---------------------------------------------------------------------
# Key that scrapers use to POST to /api/v1/ingest.
INGEST_API_KEY=dev-ingest-key-change-me
# Key you use for the review dashboard and /api/v1/review/* endpoints.
REVIEW_API_KEY=dev-review-key-change-me

# --- App ----------------------------------------------------------------------
APP_ENV=development
# Comma-separated CORS origins for the read API. "*" is fine locally.
CORS_ORIGINS=*
# Public read endpoints require no key. Set true to lock the whole read API
# behind REVIEW_API_KEY as well (useful if the dataset is embargoed).
REQUIRE_KEY_FOR_READS=false
